.add('show')}
function hideStop(){document.getElementById('stopModal').classList.remove('show')}
function endChat(report){hideStop();show('chats');toast(report?'Connection ended · report queued':'Connection ended')}
function fakeCrossings(){toast('Daily Crossings — prototype');}
const self=document.getElementById('selfPrompt');self.addEventListener('input',()=>document.getElementById('chars').textContent=self.value.length);document.getElementById('chars').textContent=self.value.length;
function savePrompt(){toast('Saved');show('discover')}
document.addEventListener('visibilitychange',()=>{if(document.hidden&&current&&research.started&&!research.completed){logEvent('session_hidden',{index:idx,dwell_ms:Date.now()-shownAt})}});
window.addEventListener('beforeunload',()=>{if(research.started&&!research.completed){try{research.last_seen=new Date().toISOString();research.last_index=idx;saveResearchDraft()}catch(e){}}});

let autosaveTimer=null;
function scheduleAutosave(){if(!research.started||research.completed)return;clearTimeout(autosaveTimer);autosaveTimer=setTimeout(()=>submitResearch(false),1800)}
window.addEventListener('pagehide',()=>{if(!research.started)return;try{const blob=new Blob([JSON.stringify(research)],{type:'application/json'});navigator.sendBeacon('/api/session',blob)}catch(e){}});
</script>

<script>
// PWA shell: installable web app. Payments are intentionally not wired in this prototype.
let deferredInstallPrompt=null;
const installChip=document.getElementById('installChip');
window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();deferredInstallPrompt=e;installChip?.classList.add('show')});
installChip?.addEventListener('click',async()=>{if(!deferredInstallPrompt)return;deferredInstallPrompt.prompt();await deferredInstallPrompt.userChoice;deferredInstallPrompt=null;installChip.classList.remove('show')});
window.addEventListener('appinstalled',()=>installChip?.classList.remove('show'));
if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{}))}
</script>
</body>
</html>
