<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<meta name="theme-color" content="#fbfbff"/>
<meta name="description" content="MINUKIMI — a more intentional way to meet someone."/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
<meta name="apple-mobile-web-app-title" content="MINUKIMI"/>
<link rel="manifest" href="manifest.webmanifest"/>
<link rel="icon" href="icons/icon.svg" type="image/svg+xml"/>
<link rel="apple-touch-icon" href="icons/icon.svg"/>
<title>MINUKIMI — Research Test v0.7</title>
<style>
:root{
  --bg:#fbfbff;
  --paper:#ffffff;
  --ink:#232532;
  --muted:#7b7e8d;
  --coral:#ff7d92;
  --coral2:#ffb2bf;
  --lilac:#a995ff;
  --lilac2:#d8d0ff;
  --mint:#7fd9c8;
  --mint2:#d7f4ee;
  --blue:#8fb9ff;
  --line1:#ff7898;
  --line2:#8f82ff;
  --border:rgba(35,37,50,.08);
  --shadow:0 22px 60px rgba(56,48,92,.12);
  --soft-shadow:0 12px 34px rgba(56,48,92,.09);
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:
radial-gradient(circle at 8% 4%,rgba(169,149,255,.11),transparent 30%),
radial-gradient(circle at 90% 18%,rgba(127,217,200,.10),transparent 28%),
linear-gradient(180deg,#fdfcff,#f8f9ff 64%,#fbfbff);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
button,input,textarea{font:inherit}
button{cursor:pointer}
.app{min-height:100vh;display:grid;place-items:center;padding:28px 14px;position:relative;overflow:hidden}
.bg-lines{position:fixed;inset:0;pointer-events:none;opacity:.26;z-index:0;mix-blend-mode:multiply}
.bg-lines svg{width:100%;height:100%;display:block}
.bg-lines path{fill:none;stroke-width:1.45;vector-effect:non-scaling-stroke;stroke-linecap:round}
.bg-lines .a{stroke:url(#ga)}.bg-lines .b{stroke:url(#gb)}
.phone{position:relative;z-index:2;width:min(430px,100%);height:min(880px,calc(100vh - 28px));min-height:700px;border-radius:36px;background:rgba(255,255,255,.82);backdrop-filter:blur(26px);border:1px solid rgba(255,255,255,.9);box-shadow:0 28px 90px rgba(57,47,93,.18);overflow:hidden}
.screen{position:absolute;inset:0;display:none;background:linear-gradient(180deg,rgba(255,255,255,.90),rgba(250,250,255,.97))}
.screen.active{display:flex;flex-direction:column}
.status{height:26px;padding:10px 18px 0;font-size:11px;color:#737687;display:flex;justify-content:space-between;align-items:center}
.brand{font-weight:760;letter-spacing:.26em;font-size:13px}
.topbar{height:62px;padding:8px 18px 10px;display:flex;align-items:center;justify-content:space-between}
.icon-btn{width:40px;height:40px;border-radius:50%;border:1px solid var(--border);background:rgba(255,255,255,.8);display:grid;place-items:center;color:var(--ink);box-shadow:var(--soft-shadow)}
.pill{border-radius:999px;padding:8px 12px;font-size:12px;background:rgba(169,149,255,.10);color:#6552ba;border:1px solid rgba(169,149,255,.17)}
.install-chip{position:absolute;right:18px;top:40px;z-index:30;border:1px solid rgba(35,37,50,.08);background:rgba(255,255,255,.82);backdrop-filter:blur(14px);border-radius:999px;padding:8px 12px;font-size:11px;font-weight:700;color:#6552ba;box-shadow:0 10px 26px rgba(56,48,92,.10);display:none}.install-chip.show{display:block}
/* splash */
.splash{padding:30px 28px 24px;justify-content:space-between;overflow:hidden}
.splash-art{position:relative;height:340px;margin-top:6px}
.splash-weave{position:absolute;inset:10px -24px 18px -24px;opacity:.96}
.splash-weave svg{width:100%;height:100%;overflow:visible}
.splash-weave path{fill:none;stroke-linecap:round;stroke-width:2.2;filter:drop-shadow(0 8px 18px rgba(92,80,180,.07))}
.splash-copy h1{font-family:Georgia,"Times New Roman",serif;font-size:42px;line-height:1.02;font-weight:500;margin:0 0 12px;letter-spacing:-.035em}
.splash-copy p{margin:0;color:var(--muted);font-size:15px;line-height:1.55}
.cta{border:0;border-radius:18px;background:linear-gradient(110deg,#2b2d3b,#3b3f55);color:white;padding:15px 18px;font-weight:700;box-shadow:0 14px 30px rgba(43,45,59,.20)}
.cta.secondary{background:white;color:var(--ink);border:1px solid var(--border);box-shadow:none}
.dots{display:flex;gap:7px;justify-content:center;margin:8px 0 18px}.dot{width:7px;height:7px;border-radius:50%;background:#dedfeb}.dot.on{width:20px;border-radius:99px;background:linear-gradient(90deg,var(--coral),var(--lilac))}
/* onboarding */
.onboard{padding:16px 24px 28px;justify-content:space-between}
.onboard .art{height:330px;display:grid;place-items:center;position:relative}
.on-card{width:250px;padding:22px;border-radius:26px;background:white;border:1px solid var(--border);box-shadow:var(--shadow);position:relative}
.on-card .tiny{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.12em}.on-card .big{font-family:Georgia,serif;font-size:26px;line-height:1.2;margin:10px 0}.on-card .quote{background:linear-gradient(130deg,rgba(169,149,255,.12),rgba(127,217,200,.12));border-radius:18px;padding:16px;font-size:14px;line-height:1.5}
.gesture-demo{width:320px;height:200px;position:relative}.gesture-demo .hint{position:absolute;bottom:6px;left:0;right:0;text-align:center;color:var(--muted);font-size:12px}.demo-heart{position:absolute;left:50%;top:40px;transform:translateX(-50%);width:294px;height:124px}.demo-heart svg{width:100%;height:100%;overflow:visible}.demo-heart .demo-line{fill:none;stroke-width:3.2;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 7px 16px rgba(92,80,170,.12))}.demo-heart .demo-glow{fill:none;stroke-width:10;stroke-linecap:round;opacity:.11;filter:blur(4px)}.demo-heart .demo-heart-trace{fill:none;stroke-width:2.4;stroke-linecap:round;stroke-dasharray:7 7;opacity:.58}.demo-heart .demo-spark{fill:none;stroke:#d5cbff;stroke-width:1.5;stroke-linecap:round;opacity:.72}
.onboard h2{font-family:Georgia,serif;font-size:34px;line-height:1.04;font-weight:500;letter-spacing:-.03em;margin:0 0 12px}.onboard p{color:var(--muted);line-height:1.55;font-size:15px}
/* discovery */
.discover{background:linear-gradient(180deg,#fbfbff,#f8f9ff)}
.discover-body{flex:1;padding:0 14px 88px;overflow:hidden;position:relative}
.counter-row{display:flex;justify-content:space-between;align-items:center;padding:0 4px 10px}.counter-row b{font-size:13px}.counter-row span{font-size:12px;color:var(--muted)}
.stack{position:relative;height:calc(100% - 34px);min-height:540px}
.profile-card{position:absolute;inset:0;border-radius:28px;background:#ddd;overflow:hidden;box-shadow:var(--shadow);border:1px solid rgba(255,255,255,.9);touch-action:none;user-select:none;transition:transform .42s cubic-bezier(.2,.8,.2,1),opacity .35s ease}
.profile-card::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(16,20,38,0) 36%,rgba(14,16,26,.08) 56%,rgba(12,14,20,.68) 100%);pointer-events:none}
.profile-card .photo{position:absolute;inset:0;overflow:hidden;background:#d9dbe6}.profile-card .photo img{width:100%;height:100%;display:block;object-fit:cover;object-position:var(--focus,50% 24%);transform:scale(var(--zoom,1.02));transform-origin:var(--origin,50% 26%);transition:transform .35s ease}.profile-card .photo::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.02) 0%,rgba(255,255,255,0) 32%,rgba(10,12,18,.04) 52%,rgba(8,10,16,.44) 78%,rgba(8,10,16,.70) 100%);pointer-events:none}
.profile-card .photo-fallback{position:absolute;inset:0;display:grid;place-items:center;background:linear-gradient(145deg,#f7f1ff,#ecfffa);overflow:hidden}
.profile-card .photo-fallback::before{content:"";position:absolute;inset:8% 6% 10%;background:linear-gradient(180deg,rgba(255,255,255,.24),rgba(255,255,255,0));opacity:.5}
.profile-card .mini-line{position:absolute;left:-8%;right:-8%;height:32%;border-radius:999px;opacity:.95}
.profile-card .mini-line.one{top:18%;border-top:2px solid rgba(255,120,152,.48);transform:rotate(8deg)}
.profile-card .mini-line.two{top:42%;border-top:2px solid rgba(143,130,255,.46);transform:rotate(-4deg)}
.profile-card .mini-line.three{top:65%;border-top:2px solid rgba(115,216,199,.42);transform:rotate(6deg)}
.card-content{position:absolute;left:20px;right:20px;bottom:122px;z-index:2;color:#fff}.name-row{display:flex;align-items:center;gap:8px}.name-row h2{font-size:31px;margin:0;letter-spacing:-.03em}.verify{width:17px;height:17px;border-radius:50%;background:rgba(255,255,255,.92);display:grid;place-items:center;color:#5f7ef0;font-size:11px}.meta{font-size:13px;opacity:.92;margin-top:4px}.prompt{margin-top:14px;background:rgba(27,28,37,.23);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.24);border-radius:18px;padding:13px 14px;box-shadow:0 8px 26px rgba(12,14,22,.08)}.prompt .label{text-transform:uppercase;letter-spacing:.12em;font-size:10px;opacity:.8}.prompt .text{font-family:Georgia,serif;font-size:18px;line-height:1.27;margin-top:5px}
.card-foo