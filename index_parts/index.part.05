function shuffled(a){a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
let profiles=[],idx=0,current=null,drag=null,startX=0,startY=0,shownAt=0;
function newSessionId(){try{return 'mk_'+crypto.randomUUID()}catch(e){return 'mk_'+Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,8)}}
let research={id:newSessionId(),version:'0.7',created:new Date().toISOString(),started:'',finished:'',participant:{ageGroup:'',gender:'',apps:[],frequency:''},order:[],events:[],remembered:[],seeAgain:[],memoryText:'',gestureChoice:'',returnChoice:'',ownPrompt:'',completed:false};
function setupIntake(){
  document.querySelectorAll('#appsChoice button').forEach(b=>b.onclick=()=>{if(b.dataset.v==='None'){document.querySelectorAll('#appsChoice button').forEach(x=>x.classList.remove('on'));b.classList.add('on')}else{document.querySelector('#appsChoice button[data-v="None"]')?.classList.remove('on');b.classList.toggle('on')}});
  document.querySelectorAll('#frequencyChoice button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#frequencyChoice button').forEach(x=>x.classList.remove('on'));b.classList.add('on')});
}
function saveIntake(){
  const age=document.getElementById('ageGroup').value;
  const gender=document.getElementById('gender').value;
  const apps=[...document.querySelectorAll('#appsChoice button.on')].map(x=>x.dataset.v);
  const frequency=document.querySelector('#frequencyChoice button.on')?.dataset.v||'';
  if(!age||!frequency){document.getElementById('intakeError').textContent='Please choose an age group and recent dating-app use.';return}
  research.participant={ageGroup:age,gender:gender||'Not answered',apps,frequency};
  document.getElementById('intakeError').textContent='';saveResearchDraft();show('on1');
}
setupIntake();
function startResearch(){profiles=shuffled(baseProfiles);research.order=profiles.map(p=>p.id);research.started=new Date().toISOString();idx=0;saveResearchDraft()}
function saveResearchDraft(){try{localStorage.setItem('minukimi_research_current',JSON.stringify(research))}catch(e){}}
function logEvent(type,extra={}){research.events.push({t:Date.now(),type,profile:current?.id||'',condition:current?.condition||'',...extra});saveResearchDraft()}
function show(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active')}
function loadCard(){
  const stack=document.getElementById('stack');stack.innerHTML='';
  document.getElementById('crossingTitle').textContent=profiles.length+' people in this test';
  if(idx>=profiles.length){document.getElementById('progressText').textContent=profiles.length+' / '+profiles.length;renderMemoryGrid('memoryGrid1',new Set());show('memory1');return}
  current=profiles[idx];shownAt=Date.now();logEvent('shown',{index:idx});document.getElementById('progressText').textContent=(idx+1)+' / '+profiles.length;
  const label=current.condition==='prompt'?'In my head, I’m…':'About me';
  const card=document.createElement('article');card.className='profile-card';card.id='card';
  card.innerHTML=`<div class="photo-fallback"><div class="mini-line one"></div><div class="mini-line two"></div><div class="mini-line three"></div></div><div class="photo" style="--focus:${current.focus||'50% 24%'};--zoom:${current.zoom||'1.02'}"><img src="${current.photo}" alt="${current.name}" loading="eager" onerror="this.parentNode.style.display='none'"></div><div class="card-content"><div class="name-row"><h2>${current.name}, ${current.age}</h2><span class="verify">✓</span></div><div class="meta">${current.city} · ${current.job}</div><div class="prompt"><div class="label">${label}</div><div class="text">${current.text}</div></div></div><div class="card-footer"><div class="connection" id="connection"><svg viewBox="0 0 292 96" aria-label="Connect gesture"><defs><linearGradient id="leftGrad" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#ff7898"/><stop offset="1" stop-color="#c28cff"/></linearGradient><linearGradient id="rightGrad" x1="1" y1="0" x2="0" y2="1"><stop stop-color="#73d8c7"/><stop offset="1" stop-color="#8f82ff"/></linearGradient><linearGradient id="heartGrad" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#ff7898"/><stop offset=".5" stop-color="#bc8eff"/><stop offset="1" stop-color="#73d8c7"/></linearGradient><linearGradient id="centerGlowLine" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#ffd2dc"/><stop offset=".5" stop-color="#ece6ff"/><stop offset="1" stop-color="#cbf5ee"/></linearGradient></defs><path class="center-flare" d="M133 45 C139 40 142 39 147 45 C152 39 155 40 161 45"/><path class="center-flare-sharp" d="M138 45 C142 42 144 42 147 45 C150 42 152 42 156 45"/><g class="half-group" id="leftHalf"><path class="sig-glow" d="M28 67 C55 68 74 64 90 47 C102 34 109 19 121 19 C133 19 141 28 145 42" stroke="url(#leftGrad)"/><path class="sig-line" d="M28 67 C55 68 74 64 90 47 C102 34 109 19 121 19 C133 19 141 28 145 42" stroke="url(#leftGrad)"/><path class="hit-line" d="M28 67 C55 68 74 64 90 47 C102 34 109 19 121 19 C133 19 141 28 145 42"/><path class="handle-mark l" d="M19 67 L31 67"/></g><g class="half-group" id="rightHalf"><path class="sig-glow" d="M264 67 C237 68 218 6