  {id:'p06',name:'Sam',age:30,city:'Lisbon',job:'Photographer',condition:'prompt',text:'already halfway through another life, carrying one bag and no backup plan.',focus:'50% 18%',zoom:'1.00',photo:'https://images.unsplash.com/photo-1684327596702-6bbbe1422375?auto=format&fit=crop&fm=jpg&ixid=NHwxMjA3fDA%3D&ixlib=rb-4.1.0&q=72&w=1200'},
  {id:'c06',name:'Adrian',age:35,city:'Vienna',job:'Journalist',condition:'control',text:'Books, cycling and dinners that somehow turn into two-hour walks.',focus:'50% 19%',zoom:'1.02',photo:'https://images.unsplash.com/photo-1512441944949-3d243fe34329?auto=format&fit=crop&fm=jpg&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&ixlib=rb-4.1.0&q=72&w=1200'},
