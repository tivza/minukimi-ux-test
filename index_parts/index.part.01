ter{position:absolute;left:12px;right:12px;bottom:12px;height:94px;z-index:3;border-radius:22px;background:rgba(252,252,255,.90);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.92);display:flex;align-items:center;justify-content:center;box-shadow:0 10px 24px rgba(18,20,32,.14)}
.connection{position:relative;width:292px;height:96px;touch-action:none;isolation:isolate}.connection::before{content:"";position:absolute;left:20px;right:20px;top:6px;bottom:18px;border-radius:999px;background:linear-gradient(180deg,rgba(255,255,255,.42),rgba(255,255,255,.08));border:1px solid rgba(255,255,255,.32);box-shadow:inset 0 1px 0 rgba(255,255,255,.65)}.connection svg{width:100%;height:100%;overflow:visible;position:relative;z-index:2}.connection .sig-line{fill:none;stroke-width:3.3;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 7px 12px rgba(94,76,176,.14));vector-effect:non-scaling-stroke}.connection .sig-glow{fill:none;stroke-width:11;stroke-linecap:round;opacity:.09;filter:blur(4px);vector-effect:non-scaling-stroke}.connection .hit-line{fill:none;stroke:transparent;stroke-width:28;pointer-events:stroke;cursor:grab}.connection .hit-line:active{cursor:grabbing}.half-group{transform-box:fill-box;transform-origin:center;will-change:transform;transition:filter .18s ease,opacity .18s ease}.connection.dragging .half-group{filter:drop-shadow(0 10px 20px rgba(93,72,188,.22))}.center-flare{fill:none;stroke:url(#centerGlowLine);stroke-width:12;opacity:.18;filter:blur(5px);transform-origin:center;transition:opacity .18s ease,transform .18s ease;transform:scale(.75)}.connection .center-flare-sharp{fill:none;stroke:url(#centerGlowLine);stroke-width:2.2;opacity:.45;transition:opacity .18s ease,transform .18s ease;transform-origin:center;transform:scale(.9)}.connection.dragging .center-flare{opacity:.66;transform:scale(1.18)}.connection.dragging .center-flare-sharp{opacity:.85;transform:scale(1.06)}.handle-mark{fill:none;stroke-width:2;stroke-linecap:round;opacity:.44}.handle-mark.l{stroke:#ff8ba2}.handle-mark.r{stroke:#80d9c8}.heart-trace{fill:none;stroke:url(#heartGrad);stroke-width:2.9;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:220;stroke-dashoffset:220;opacity:0;filter:drop-shadow(0 7px 14px rgba(150,110,220,.22))}.connection.connected .heart-trace{opacity:1;animation:heartTrace .55s cubic-bezier(.2,.8,.2,1) forwards}.connection.connected .half-group{opacity:.14}.connection.attract .sig-line{stroke-width:3.5}.connection.attract .center-flare{opacity:1;transform:scale(1.25)}.connection.attract .center-flare-sharp{opacity:1;transform:scale(1.08)}@keyframes heartTrace{0%{stroke-dashoffset:220;transform:scale(.88);transform-origin:center}70%{stroke-dashoffset:0;transform:scale(1.06)}100%{stroke-dashoffset:0;transform:scale(1)}}.conn-label{position:absolute;bottom:0;left:0;right:0;text-align:center;font-size:10.5px;color:#858896;letter-spacing:.035em;z-index:2}.connect-fallback{position:absolute;right:3px;top:4px;border:0;background:rgba(255,255,255,.66);color:#7767df;font-size:10px;font-weight:760;padding:6px 8px;border-radius:999px;z-index:3}.connect-fallback:hover{background:rgba(169,149,255,.10)}
.toast{position:absolute;left:50%;top:84px;transform:translate(-50%,-12px);background:#252838;color:white;padding:10px 14px;border-radius:999px;font-size:12px;opacity:0;pointer-events:none;transition:.28s;z-index:20}.toast.show{opacity:1;transform:translate(-50%,0)}
.shard{position:absolute;width:8px;height:8px;border-radius:50%;pointer-events:none;z-index:8;animation:shatter .55s ease-out forwards}@keyframes shatter{to{transform:translate(var(--dx),var(--dy)) scale(.2);opacity:0}}

/* research intake */
.intake-screen{overflow:auto;padding-bottom:28px;background:linear-gradient(180deg,#fcfcff,#f7f8ff)}
.intake-wrap{padding:10px 18px 26px}.intake-wrap h1{font-family:Georgia,serif;font-size:35px;line-height:1.04;font-weight:500;letter-spacing:-.03em;margin:12px 0 10px}.intake-wrap>p{color:var(--muted);font-size:13px;line-height:1.55;margin:0 0 18px}
.intake-card{background:#fff;border:1px solid var(--border);border-radius:22px;padding:16px;margin:10px 0;box-shadow:var(--soft-shadow)}.intake-card label{display:block;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.11em;margin-bottom:10px}.intake-card select{width:100%;border:1px solid var(--border);background:#fff;border-radius:14px;padding:12px;color:var(--ink);outline:none}.multi-choice{display:flex;flex-wrap:wrap;gap:8px}.multi-choice button{border:1px solid var(--border);background:#fff;color:#666a79;border-radius:999px;padding:9px 12px;font-size:12px}.multi-choice button.on{background:linear-gradient(90deg,rgba(255,125,146,.14),rgba(169,149,255,.14));border-color:rgba(140,120,240,.30);color:#5f50b4;font-weight:700}.privacy-note{font-size:11px;color:#8b8e9b;line-height:1.5;margin:12px 2px 16px}.intake-error{font-size:12px;color:#b84f62;min-height:18px;margin-top:8px}
/* UX test */
.test-screen{overflow:auto;padding-bottom:30px;background:linear-gradient(180deg,#fcfcff,#f7f8ff)}
.test-head{padding:8px 20px 0}.test-head h1{font-family:Georgia,serif;font-weight:500;font-size:34px;line-height:1.04;margin:6px 0 8px;letter-spacing:-.03em}.test-head p{color:var(--muted);font-size:13px;line-height:1.5;margin:0}
.memory-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:18px 14px}.memory-face{position:relative;aspect-ratio:.78;border-radius:18px;overflow:hidden;border:2px solid transparent;background:#ececf5;padding:0;box-shadow:0 6px 18px rgba(56,48,92,.07)}.memory-face img{width:100%;height:100%;object-fit:cover;display:block}.memory-face::after{content:"";position:absolute;inset:0;border-radius:16px;background:linear-gradient(180deg,transparent 55%,rgba(13,15,25,.32));opacity:.55}.memory-face.selected{border-color:#9a86ff;box-shadow:0 0 0 4px rgba(154,134,255,.12),0 10px 24px rgba(80,65,155,.15)}.memory-face.selected::before{content:"✓";position:absolute;z-index:3;right:7px;top:7px;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:#fff;color:#6e5ce2;font-weight:900;font-size:12px;box-shadow:0 4px 10px rgba(35,37,50,.14)}
.test-actions{padding:4px 14px 20px;display:flex;gap:10px}.test-actions .cta{flex:1}.test-card{margin:14px;border-radius:24px;background:white;border:1px solid var(--border);padding:18px;box-shadow:var(--soft-shadow)}.test-card label{display:block;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.12em;margin-bottom:8px}.test-card textarea{width:100%;min-height:92px;border:1px solid var(--border);border-radius:16px;padding:12px;resize:vertical;outline:0}.choice-row{display:flex;gap:8px;flex-wrap:wrap}.choice-chip{border:1px solid var(--border);background:#fff;border-radius:999px;padding:9px 12px;font-size:12px;color:#626575}.choice-chip.active{background:linear-gradient(90deg,rgba(255,125,146,.14),rgba(169,149,255,.14));border-color:rgba(140,120,240,.28);color:#5f50b4;font-weight:700}.results-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px}.result-tile{background:#fff;border:1px solid var(--border);border-radius:20px;padding:16px;box-shadow:var(--soft-shadow)}.result-tile b{display:block;font-family:Georgia,serif;font-size:28px;font-weight:500}.result-tile span{font-size:11px;color:var(--muted);line-height:1.4}.result-note{margin:14px;background:linear-gradient(135deg,rgba(169,149,255,.12),rgba(127,217,200,.12));border:1px solid rgba(169,149,255,.14);border-radius:22px;padding:17px;font-size:13px;line-height:1.55;color:#55596b}.research-badge{position:absolute;left:16px;top:42px;z-index:8;background:rgba(255,255,255,.82);backdrop-filter:blur(12px);border:1px solid rgba(35,37,50,.07);border-radius:999px;padding:7px 10px;font-size:10px;color:#777b8c;box-shadow:0 8px 18px rgba(56,48,92,.08)}

/* match */
.modal{position:absolute;inset:0;background:rgba(28,30,45,.46);backdrop-filter:blur(12px);z-index:50;display:none;align-items:center;justify-content:center;padding:24px}.modal.show{display:flex}.match-card{width:100%;background:rgba(255,255,255,.96);border-radius:30px;padding:28px 22px 22px;text-align:center;box-shadow:0 30px 90px rgba(38,34,64,.28)}
.match-lines{height:124px;position:relative}.match-lines svg{width:100%;height:100%;overflow:visible}.match-lines path{fill:none;stroke-width:2.7;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:280;stroke-dashoffset:280;animation:draw 1.05s cubic-bezier(.2,.8,.2,1) forwards;filter:drop-shadow(0 6px 10px rgba(90,75,170,.10))}.match-lines .cross{stroke-width:2.2;animation-delay:.35s}@keyframes draw{to{stroke-dashoffset:0}}
.match-card h2{font-family:Georgia,serif;font-size:34px;font-weight:500;margin:4px 0 8px}.match-card p{color:var(--muted);font-size:14px;line-height:1.5;margin:0 0 18px}.match-actions{display:grid;gap:9px}
/* nav */
.bottom-nav{position:absolute;left:14px;right:14px;bottom:12px;height:62px;border-radius:22px;background:rgba(255,255,255,.92);backdrop-filter