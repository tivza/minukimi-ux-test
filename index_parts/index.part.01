<section class="screen" id="profileBasics"><div class="topbar"><button class="icon" onclick="show('profilePhoto')">←</button><div class="brand">MINUKIMI</div><span class="ghost-slot"></span></div><div class="page"><div class="kicker">Create profile · 2 of 4</div><div class="progress"><i style="width:50%"></i></div><h1 class="headline">The useful facts.</h1><p class="sub">Keep this part familiar. Enough to know who you are and what kind of connection you want.</p><div class="field-grid"><div class="pair"><div class="field"><label>First name</label><input id="f_name" maxlength="24" placeholder="Alex"></div><div class="field"><label>Age</label><input id="f_age" type="number" min="18" max="99" placeholder="31"></div></div><div class="field city-wrap"><label>City</label><input id="f_city" autocomplete="off" placeholder="Start typing a city"><div class="city-list" id="cityList"></div></div><div class="field"><label>Profession · optional</label><input id="f_job" maxlength="40" placeholder="Designer"></div><div class="pair"><div class="field"><label>Looking for</label><select id="f_looking"><option value="">Choose</option><option>Women</option><option>Men</option><option>Everyone</option></select></div><div class="field"><label>Relationship goal</label><select id="f_goal"><option value="">Choose</option><option>Long-term relationship</option><option>Long-term, open to see</option><option>Dates, no pressure</option><option>Still figuring it out</option></select></div></div></div><div class="error" id="basicsError"></div><button class="cta wide" id="basicsNext">Next</button></div></section>
<section class="screen" id="profilePrompt"><div class="topbar"><button class="icon" onclick="show('profileBasics')">←</button><div class="brand">MINUKIMI</div><span class="ghost-slot"></span></div><div class="page"><div class="kicker">Create profile · 3 of 4</div><div class="progress"><i style="width:75%"></i></div><h1 class="headline">In my head, I'm...</h1><p class="sub">Finish the sentence with a version of you that feels true inside. Keep it short enough to live beside the photo.</p><div class="examples"><button data-example="already living near the sea, wearing linen and kissing first.">near the sea...</button><button data-example="the person who actually books the ticket instead of keeping fourteen tabs open.">books the ticket...</button><button data-example="calmer, braver, and the one people call when something goes wrong.">calmer, braver...</button></div><div class="field"><label>In my head, I'm...</label><textarea id="f_prompt" maxlength="110" placeholder="already living near the sea, wearing linen and kissing first."></textarea><div class="count"><span id="promptCount">0</span> / 110</div></div><div class="error" id="promptError"></div><button class="cta wide" id="promptNext">Preview profile</button></div></section>
<section class="screen" id="profilePreview"><div class="topbar"><button class="icon" onclick="show('profilePrompt')">←</button><div class="brand">MINUKIMI</div><span class="ghost-slot"></span></div><div class="page"><div class="kicker">Create profile · 4 of 4</div><div class="progress"><i style="width:100%"></i></div><h1 class="headline">This is how you arrive.</h1><p class="sub">Photo first. Facts second. One line that gives someone a reason to pause.</p><div class="preview-card"><img id="previewImg" alt=""><div class="preview-info"><div class="preview-name" id="previewName">You</div><div class="preview-meta" id="previewMeta"></div><div class="preview-prompt"><small>In my head, I'm...</small><div id="previewPrompt"></div></div></div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:12px"><button class="secondary" onclick="show('profilePhoto')">Edit photo</button><button class="secondary" onclick="show('profileBasics')">Edit details</button></div><button class="cta wide" id="publishBtn" style="margin-top:9px">Publish profile</button></div></section>
<section class="screen discover" id="discover"><div class="topbar"><div class="brand">MINUKIMI</div><button class="icon" onclick="nav('myProfile')">○</button></div><div class="discover-body"><div class="counter"><b>Daily crossings</b><span id="progressText">1 / 6</span></div><div class="stack" id="stack"></div></div><nav class="bottom-nav"><button class="nav-item active" data-nav="discover"><span>◌</span><span>Discover</span></button><button class="nav-item" data-nav="crossings"><span>⌁</span><span>Crossings</span></button><button class="nav-item" data-nav="chats"><span>▢</span><span>Chats</span></button><button class="nav-item" data-nav="myProfile"><span>○</span><span>You</span></button></nav></section>
