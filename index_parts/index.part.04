  {id:'c04',name:'Nicky',age:30,city:'Berlin',job:'Event producer',condition:'control',text:'Night owl, coffee addict, much easier to understand in person than in a bio.',focus:'50% 22%',zoom:'1.00',photo:'https://images.unsplash.com/photo-1649675728586-647922b8ed7b?auto=format&fit=crop&fm=jpg&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&ixlib=rb-4.1.0&q=72&w=1200'},
  {id:'p05',name:'Nora',age:40,city:'Copenhagen',job:'Psychotherapist',condition:'prompt',text:'less careful, more sun-warmed, and the person who says yes before overthinking.',focus:'50% 22%',zoom:'1.00',photo:'https://images.unsplash.com/photo-1733971717497-6835242a3e09?auto=format&fit=crop&fm=jpg&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&ixlib=rb-4.1.0&q=72&w=