4 202 47 C190 34 183 19 171 19 C159 19 151 28 147 42" stroke="url(#rightGrad)"/><path class="sig-line" d="M264 67 C237 68 218 64 202 47 C190 34 183 19 171 19 C159 19 151 28 147 42" stroke="url(#rightGrad)"/><path class="hit-line" d="M264 67 C237 68 218 64 202 47 C190 34 183 19 171 19 C159 19 151 28 147 42"/><path class="handle-mark r" d="M259 67 L271 67"/></g><path class="heart-trace" d="M147 78 C121 58 108 43 111 29 C115 14 132 15 141 29 C144 33 146 37 147 42 C148 37 150 33 153 29 C162 15 179 14 183 29 C186 43 173 58 147 78"/></svg><div class="conn-label">pull together to connect · pull away to pass</div><button class="connect-fallback" onclick="connect(true);event.stopPropagation()">CONNECT</button></div></div>`;
  stack.appendChild(card);wireGesture();
}
function wireGesture(){
  const conn=document.getElementById('connection');
  const halves=[document.getElementById('leftHalf'),document.getElementById('rightHalf')];
  halves.forEach((h,i)=>{
    h.addEventListener('pointerdown',e=>{
      drag={h,side:i===0?'left':'right'};startX=e.clientX;startY=e.clientY;
      conn.classList.add('dragging');logEvent('gesture_start',{side:i===0?'left':'right',dwell_ms:Date.now()-shownAt});h.setPointerCapture(e.pointerId)
    });
    h.addEventListener('pointermove',e=>{
      if(!drag||drag.h!==h)return;
      const dx=e.clientX-startX,dy=e.clientY-startY;
      const toward=drag.side==='left'?Math.max(0,dx):Math.min(0,dx);
      const away=drag.side==='left'?Math.min(0,dx):Math.max(0,dx);
      const tx=Math.max(-112,Math.min(112,toward+away*.82));
      const ty=Math.max(-10,Math.min(10,dy*.05));
      h.style.transform=`translate(${tx}px,${ty}px)`;
      const pull=Math.min(1,Math.abs(toward)/54);
      const flare=conn.querySelector('.center-flare'); const sharp=conn.querySelector('.center-flare-sharp'); if(flare) flare.style.opacity=String(.18+.5*pull); if(sharp) sharp.style.opacity=String(.45+.35*pull);
      if(pull>.62) conn.classList.add('attract'); else conn.classList.remove('attract');
      if(Math.abs(away)>110){pass(true,drag.side);drag=null;conn.classList.remove('dragging');conn.classList.remove('attract')}
    });
    h.addEventListener('pointerup',e=>{
      if(!drag||drag.h!==h)return;
      const dx=e.clientX-startX;
      const toward=drag.side==='left'?dx:-dx;
      conn.classList.remove('dragging');
      conn.classList.remove('attract');
      const flare=conn.querySelector('.center-flare'); const sharp=conn.querySelector('.center-flare-sharp'); if(flare) flare.style.opacity=''; if(sharp) sharp.style.opacity='';
      if(toward>48)connect(false);
      else{logEvent('gesture_abandon',{side:drag.side,dwell_ms:Date.now()-shownAt});h.style.transition='transform .38s cubic-bezier(.2,.8,.2,1)';h.style.transform='';setTimeout(()=>h.style.transition='',400)}
      drag=null
    })
  })
}
function toast(t){const el=document.getElementById('toast');el.textContent=t;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),900)}
function connect(fallback){
  logEvent('connect',{method:fallback?'button':'gesture',dwell_ms:Date.now()-shownAt});
  const conn=document.getElementById('connection'),l=document.getElementById('leftHalf'),r=document.getElementById('rightHalf');if(!conn||!l||!r)return;
  conn.classList.remove('dragging');conn.classList.remove('attract');conn.classList.add('connected');
  l.style.transition=r.style.transition='transform .46s cubic-bezier(.16,.9,.24,1)';
  l.style.transform='translate(8px,1px)';r.style.transform='translate(-8px,1px)';
  if(navigator.vibrate)navigator.vibrate([12,18,22]);
  toast('I see it.');
  setTimeout(()=>nextCard('connected'),620)
}
function pass(flick,side){
  logEvent('pass',{method:flick?'flick':'other',dwell_ms:Date.now()-shownAt});
  const card=document.getElementById('card'),conn=document.getElementById('connection');if(!card)return;
  const h=side==='right'?document.getElementById('rightHalf'):document.getElementById('leftHalf');
  if(h){h.style.transition='transform .26s cubic-bezier(.2,.7,.3,1),opacity .22s ease';h.style.transform=`translate(${side==='right'?125:-125}px,-4px)`;h.style.opacity='.05'}
  if(conn){conn.classList.remove('dragging');conn.classList.remove('attract');}
  for(let i=0;i<7;i++){const s=document.createElement('i');s.className='shard';s.style.width=s.style.height=(4+Math.random()*3)+'px';s.style.background=i%2?'#8f82ff':'#ff7898';s.style.left=(side==='right'?205:58+Math.random()*35)+'px';s.style.bottom=(48+Math.random()*24)+'px';s.style.setProperty('--dx',((side==='right'?1:-1)*(34+Math.random()*56))+'px');s.style.setProperty('--dy',(Math.random()*-38-6)+'px');card.appendChild(s)}
  card.style.transform='translateY(4px) scale(.992)';card.style.opacity='.18';setTimeout(()=>nextCard('pass'),360)
}
function nextCard(){idx++;loadCard()}
function faceButton(p,selected){return `<button class="memory-face ${selected?'selected':''}" data-id="${p.id}" onclick="toggleFace(this)"><img src="${p.photo}" alt="" style="object-position:${p.focus||'50% 24%'}" onerror="this.style.display='none'"></button>`}
function renderMemoryGrid(id,selected){const el=document.getElementById(id);const order=shuffled(baseProfiles);el.dataset.order=order.map(p=>p.id).join(',');el.innerHTML=order.map(p=>faceButton(p,selected.has(p.id))).join('')}
function toggleFace(btn){btn.classList.toggle('selected')}
function selectedFrom(id){return [...document.querySelectorAll('#'+id+' .memory-face.selected')].map(x=>x.dataset.id)}
function saveMemoryStep1(){research.remembered=selectedFrom('memoryGrid1');saveResearchDraft();renderMemoryGrid('memoryGrid2',new Set(research.seeAgain));show('memory2')}
function saveMemoryStep2(){research.seeAgain=selectedFrom('memoryGrid2');saveResearchDraft();show('memory3')}
function pickChoice(group,btn){document.querySelectorAll('#'+group+' .choice-chip').forEach(x=>x.classList.remove('active'));btn.classList.add('active')}
async function finishResearch(){research.memoryText=document.getElementById('memoryText').value.trim();research.ownPrompt=document.getElementById('ownPrompt').value.trim();research.gestureChoice=document.querySelector('#gestureChoice .choice-chip.active')?.dataset.v||'';research.returnChoice=document.querySelector('#returnChoice .choice-chip.active')?.dataset.v||'';research.finished=new Date().toISOString();research.completed=true;research.duration_ms=research.started?new Date(research.finished)-new Date(research.started):0;try{const all=JSON.parse(localStorage.getItem('minukimi_research_sessions')||'[]');all.push(JSON.parse(JSON.stringify(research)));localStorage.setItem('minukimi_research_sessions',JSON.stringify(all))}catch(e){}saveResearchDraft();document.getElementById('completionId').textContent=research.id;show('results');await submitResearch(true)}
async function submitResearch(isFinal=false){const status=document.getElementById('saveStatus');try{const r=await fetch('/api/session',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(research)});if(!r.ok)throw new Error('HTTP '+r.status);const j=await r.json();if(status)status.textContent=isFinal?'Saved. Thank you.':'Progress saved.';const fb=document.getElementById('fallbackDownload');if(fb)fb.style.display='none';return true}catch(e){if(status)status.textContent='Could not reach the research server. Please download the backup file.';const fb=document.getElementById('fallbackDownload');if(fb)fb.style.display='block';return false}}
function exportResearch(){const blob=new Blob([JSON.stringify(research,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='minukimi_v05_'+research.id+'.json';a.click();URL.revokeObjectURL(a.href)}
function resetResearch(){research={id:newSessionId(),version:'0.7',created:new Date().toISOString(),started:'',finished:'',participant:{ageGroup:'',gender:'',apps:[],frequency:''},order:[],events:[],remembered:[],seeAgain:[],memoryText:'',gestureChoice:'',returnChoice:'',ownPrompt:'',completed:false};profiles=[];idx=0;document.getElementById('ageGroup').value='';document.getElementById('gender').value='';document.querySelectorAll('#appsChoice button,#frequencyChoice button,.choice-chip').forEach(x=>x.classList.remove('on','active'));document.getElementById('memoryText').value='';document.getElementById('ownPrompt').value='';saveResearchDraft();show('intake')}

function closeMatch(){document.getElementById('matchModal').classList.remove('show');idx++;loadCard()}
function openChat(name){document.getElementById('chatName').textContent=name;show('chat')}
function sendMsg(){const inp=document.getElementById('msgInput');const v=inp.value.trim();if(!v)return;if(v.toUpperCase()==='KIMI'){inp.value='';showStop();return}const b=document.createElement('div');b.className='bubble me';b.textContent=v;document.getElementById('messages').appendChild(b);inp.value='';document.getElementById('messages').scrollTop=99999}
function showStop(){document.getElementById('stopModal').classList